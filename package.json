{
  "name": "@common-grants/cg-california",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE.upstream-MIT",
    "NOTICE.md",
    "README.md",
    "MAPPING.md",
    "fixtures/public-sanitized.json",
    "scripts/example.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "example": "node scripts/example.mjs",
    "drift": "node --import tsx scripts/drift.ts",
    "privacy": "node scripts/privacy.mjs",
    "prepack": "npm run build && npm run privacy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@common-grants/sdk": "^0.9.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@common-grants/sdk": "0.9.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "zod": "^4.6.7"
  }
}
